---
import "../styles/global.css";
import { Toaster } from "@/components/ui/sonner";
import { Navigation } from "@/components/shared/Navigation";

interface Props {
  title?: string;
  currentPage?: "equipment" | "users";
}

const { title = "ServiceRegistry", currentPage } = Astro.props;

// Check if user is authenticated
const accessToken = Astro.cookies.get("sb-access-token")?.value;
const refreshToken = Astro.cookies.get("sb-refresh-token")?.value;
const isAuthenticated = Boolean(accessToken && refreshToken);

// Get user info if authenticated
let userEmail: string | undefined;
if (isAuthenticated) {
  const { data: { user } } = await Astro.locals.supabase.auth.getUser();
  userEmail = user?.email;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Navigation client:load currentPage={currentPage} isAuthenticated={isAuthenticated} userEmail={userEmail} />
    <slot />
    <Toaster client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
