# Supabase Configuration
# Copy this file to .env and fill in the values

# For local development (after running: npm run db:start)
# Use the credentials from the terminal output
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your_local_publishable_key_here

# For production deployment
# Get these from your Supabase project dashboard at supabase.com
# PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
